{
  "name": "siteindex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SiteIndex — 独立站运营数据工作区桌面软件（Windows 为主，兼容 macOS）",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "dev:ui": "pnpm --filter @siteindex/ui dev",
    "dev:desktop": "pnpm --filter @siteindex/desktop dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
