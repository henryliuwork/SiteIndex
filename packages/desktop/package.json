{
  "name": "@siteindex/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "SiteIndex 桌面应用",
  "author": "SiteIndex",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:dist": "pnpm --filter @siteindex/cli build && pnpm build && node scripts/prepare-resources.mjs",
    "dist:win": "pnpm prepare:dist && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm prepare:dist && electron-builder --mac dmg zip --universal --publish never",
    "dist:win:release": "pnpm prepare:dist && electron-builder --win nsis --publish always",
    "dist:mac:release": "pnpm prepare:dist && electron-builder --mac dmg zip --universal --publish always"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@siteindex/core": "workspace:*",
    "@siteindex/shared": "workspace:*",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.siteindex.desktop",
    "productName": "SiteIndex",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "henryliuwork",
      "repo": "SiteIndex",
      "releaseType": "draft"
    },
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/cli.js",
        "to": "cli.js"
      },
      {
        "from": "build-resources/ui",
        "to": "ui"
      },
      {
        "from": "build-resources/skills",
        "to": "skills"
      },
      {
        "from": "build-resources/templates",
        "to": "templates"
      },
      {
        "from": "build-resources/schemas",
        "to": "schemas"
      },
      {
        "from": "build-resources/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SiteIndex",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ]
  }
}
