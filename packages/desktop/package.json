{
  "name": "@siteindex/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteIndex 桌面应用",
  "author": "SiteIndex",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "pnpm build && node scripts/prepare-resources.mjs && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build && node scripts/prepare-resources.mjs && electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "@siteindex/core": "workspace:*",
    "@siteindex/shared": "workspace:*",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.siteindex.desktop",
    "productName": "SiteIndex",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/cli.js",
        "to": "cli.js"
      },
      {
        "from": "build-resources/ui",
        "to": "ui"
      },
      {
        "from": "build-resources/skills",
        "to": "skills"
      },
      {
        "from": "build-resources/templates",
        "to": "templates"
      },
      {
        "from": "build-resources/schemas",
        "to": "schemas"
      },
      {
        "from": "build-resources/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SiteIndex",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
