exports[`system schedule definitions > generates Windows monthly XML 1`] = `
"<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Author>SiteIndex</Author></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2026-10-23T06:15:00</StartBoundary><Enabled>true</Enabled><ScheduleByMonth><DaysOfMonth><Day>15</Day></DaysOfMonth><Months><January/><February/><March/><April/><May/><June/><July/><August/><September/><October/><November/><December/></Months></ScheduleByMonth></CalendarTrigger></Triggers>
  <Principals><Principal id="SiteIndex"><UserId>TEST-PCTester</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><StartWhenAvailable>true</StartWhenAvailable><WakeToRun>true</WakeToRun><Enabled>true</Enabled><AllowStartOnDemand>true</AllowStartOnDemand><ExecutionTimeLimit>PT2H</ExecutionTimeLimit></Settings>
  <Actions Context="SiteIndex"><Exec><Command>C:Program FilesSiteIndexSiteIndex.exe</Command><Arguments>--run-job &quot;C:UsersTesterCloud &amp; Drivesample-store&quot; monthly</Arguments><WorkingDirectory>C:UsersTesterCloud &amp; Drivesample-store</WorkingDirectory></Exec></Actions>
</Task>
"
`;

exports[`system schedule definitions > generates Windows weekday XML 1`] = `
"<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Author>SiteIndex</Author></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2026-10-23T02:00:00</StartBoundary><Enabled>true</Enabled><ScheduleByWeek><DaysOfWeek><Monday/><Tuesday/><Wednesday/><Thursday/><Friday/></DaysOfWeek><WeeksInterval>1</WeeksInterval></ScheduleByWeek></CalendarTrigger></Triggers>
  <Principals><Principal id="SiteIndex"><UserId>TEST-PCTester</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><StartWhenAvailable>true</StartWhenAvailable><WakeToRun>true</WakeToRun><Enabled>true</Enabled><AllowStartOnDemand>true</AllowStartOnDemand><ExecutionTimeLimit>PT2H</ExecutionTimeLimit></Settings>
  <Actions Context="SiteIndex"><Exec><Command>C:Program FilesSiteIndexSiteIndex.exe</Command><Arguments>--run-job &quot;C:UsersTesterCloud &amp; Drivesample-store&quot; daily</Arguments><WorkingDirectory>C:UsersTesterCloud &amp; Drivesample-store</WorkingDirectory></Exec></Actions>
</Task>
"
`;

exports[`system schedule definitions > generates a macOS monthly LaunchAgent plist 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.siteindex.sample-store.47b344db.monthly</string>
  <key>ProgramArguments</key><array><string>/Applications/SiteIndex.app/Contents/MacOS/SiteIndex</string><string>--run-job</string><string>/Users/tester/Cloud &amp; Drive/sample-store</string><string>monthly</string></array>
  <key>StartCalendarInterval</key><array><dict><key>Day</key><integer>15</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict></array>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
"
`;

