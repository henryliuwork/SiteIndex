// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Windows Task Scheduler definitions > generates a monthly task XML snapshot 1`] = `
"<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Author>SiteIndex</Author><Description>SiteIndex sample-store monthly</Description></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2026-10-23T06:15:00</StartBoundary><Enabled>true</Enabled><ScheduleByMonth><DaysOfMonth><Day>15</Day></DaysOfMonth><Months><January/><February/><March/><April/><May/><June/><July/><August/><September/><October/><November/><December/></Months></ScheduleByMonth></CalendarTrigger></Triggers>
  <Principals><Principal id="Author"><UserId>TEST-PC\\tester</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><AllowHardTerminate>true</AllowHardTerminate><StartWhenAvailable>true</StartWhenAvailable><WakeToRun>true</WakeToRun><Enabled>true</Enabled><ExecutionTimeLimit>PT2H</ExecutionTimeLimit><Priority>7</Priority></Settings>
  <Actions Context="Author"><Exec><Command>C:\\Program Files\\SiteIndex\\SiteIndex.exe</Command><Arguments>--run-job &quot;C:\\Users\\Tester\\Cloud &amp; Drive\\sample-store&quot; monthly</Arguments><WorkingDirectory>C:\\Users\\Tester\\Cloud &amp; Drive\\sample-store</WorkingDirectory></Exec></Actions>
</Task>
"
`;

exports[`Windows Task Scheduler definitions > generates a weekday task XML snapshot 1`] = `
"<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Author>SiteIndex</Author><Description>SiteIndex sample-store daily</Description></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2026-10-23T02:00:00</StartBoundary><Enabled>true</Enabled><ScheduleByWeek><DaysOfWeek><Monday/><Tuesday/><Wednesday/><Thursday/><Friday/></DaysOfWeek><WeeksInterval>1</WeeksInterval></ScheduleByWeek></CalendarTrigger></Triggers>
  <Principals><Principal id="Author"><UserId>TEST-PC\\tester</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><AllowHardTerminate>true</AllowHardTerminate><StartWhenAvailable>true</StartWhenAvailable><WakeToRun>true</WakeToRun><Enabled>true</Enabled><ExecutionTimeLimit>PT2H</ExecutionTimeLimit><Priority>7</Priority></Settings>
  <Actions Context="Author"><Exec><Command>C:\\Program Files\\SiteIndex\\SiteIndex.exe</Command><Arguments>--run-job &quot;C:\\Users\\Tester\\Cloud &amp; Drive\\sample-store&quot; daily</Arguments><WorkingDirectory>C:\\Users\\Tester\\Cloud &amp; Drive\\sample-store</WorkingDirectory></Exec></Actions>
</Task>
"
`;
