{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/seo_page",
  "title": "seo/pages.jsonl",
  "type": "object",
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "page_type": { "enum": ["home", "collection", "product", "blog", "page", "other"] },
    "status_code": { "type": "integer", "minimum": 0 },
    "final_url": { "type": ["string", "null"], "format": "uri" },
    "redirect_chain": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "response_ms": { "type": ["number", "null"], "minimum": 0 },
    "title": { "type": ["string", "null"] },
    "title_length": { "type": "integer", "minimum": 0 },
    "meta_description": { "type": ["string", "null"] },
    "description_length": { "type": "integer", "minimum": 0 },
    "meta_keywords": { "type": ["string", "null"] },
    "h1": { "type": ["string", "null"] },
    "h1_count": { "type": "integer", "minimum": 0 },
    "h2": { "type": "array", "items": { "type": "string" } },
    "canonical": { "type": ["string", "null"] },
    "canonical_status": { "enum": ["self", "other", "missing"] },
    "robots_meta": { "type": ["string", "null"] },
    "x_robots_tag": { "type": ["string", "null"] },
    "indexable": { "type": "boolean" },
    "in_sitemap": { "type": "boolean" },
    "google_indexed": { "type": ["boolean", "null"] },
    "index_checked_at": { "type": ["string", "null"], "format": "date" },
    "hreflang": { "type": "array", "items": { "type": "object", "required": ["lang", "url"], "properties": { "lang": { "type": "string" }, "url": { "type": "string", "format": "uri" } } } },
    "og": { "type": "object", "properties": { "title": { "type": ["string", "null"] }, "description": { "type": ["string", "null"] }, "image": { "type": ["string", "null"] } } },
    "twitter_card": { "type": ["string", "null"] },
    "schema_types": { "type": "array", "items": { "type": "string" } },
    "schema_errors": { "type": "array", "items": { "type": "string" } },
    "word_count": { "type": ["integer", "null"], "minimum": 0 },
    "images_total": { "type": "integer", "minimum": 0 },
    "images_missing_alt": { "type": "integer", "minimum": 0 },
    "links_internal_out": { "type": "integer", "minimum": 0 },
    "links_external_out": { "type": "integer", "minimum": 0 },
    "links_internal_in": { "type": "integer", "minimum": 0 },
    "last_crawled": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "required": ["url", "page_type", "status_code", "title", "title_length", "meta_description", "description_length", "h1", "h1_count", "canonical", "canonical_status", "robots_meta", "x_robots_tag", "indexable", "in_sitemap", "schema_types", "word_count", "last_crawled"],
  "x-primary-key": ["url"]
}
