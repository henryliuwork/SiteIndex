{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/category",
  "title": "catalog/categories.json[]",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": ["url_rule", "feed", "manual", "none"]
    },
    "product_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "sku_count": { "type": "integer", "minimum": 0 },
    "in_stock_count": { "type": "integer", "minimum": 0 },
    "intro_text_words": { "type": ["integer", "null"], "minimum": 0 },
    "last_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "slug",
    "name",
    "url",
    "parent",
    "source",
    "last_seen"
  ],
  "x-primary-key": [
    "slug"
  ]
}
