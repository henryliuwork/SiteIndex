{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/inventory_event",
  "title": "inventory/events/*.jsonl",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sku": {
      "type": "string"
    },
    "type": {
      "enum": [
        "stock_change",
        "price_change",
        "new_sku",
        "removed_sku",
        "restored_sku"
      ]
    },
    "from": {},
    "to": {},
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "sku",
    "type",
    "category",
    "title"
  ],
  "x-primary-key": [
    "date",
    "sku",
    "type"
  ]
}