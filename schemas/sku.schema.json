{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/sku",
  "title": "catalog/skus.jsonl",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string"
    },
    "parent_sku": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "handle": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "variant_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "category": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category_source": {
      "enum": [
        "url_rule",
        "feed",
        "manual",
        "none"
      ]
    },
    "product_type_raw": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "highlights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attributes": {
      "type": "object",
      "properties": {
        "color": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "material": { "type": ["string", "null"] },
        "pattern": { "type": ["string", "null"] },
        "gender": { "type": ["string", "null"] },
        "age_group": { "type": ["string", "null"] },
        "condition": { "type": ["string", "null"] },
        "shipping_weight": { "type": ["string", "null"] }
      }
    },
    "custom_labels": {
      "type": "array",
      "items": { "type": ["string", "null"] }
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "compare_at_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "removed"
      ]
    },
    "removed_reason": {
      "enum": [
        "feed_absent_404",
        "feed_absent_aged",
        "superseded_by_feed"
      ]
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "sku",
    "product_id",
    "handle",
    "title",
    "url",
    "category",
    "category_source",
    "price",
    "currency",
    "status",
    "first_seen",
    "last_seen",
    "updated_at"
  ],
  "x-primary-key": [
    "sku"
  ]
}
