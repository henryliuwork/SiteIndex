{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/sku",
  "title": "catalog/skus.jsonl",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "variant_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "category": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "compare_at_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "removed"
      ]
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "sku",
    "product_id",
    "handle",
    "title",
    "url",
    "category",
    "price",
    "currency",
    "status",
    "first_seen",
    "last_seen",
    "updated_at"
  ],
  "x-primary-key": [
    "sku"
  ]
}