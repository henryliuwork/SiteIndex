{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/validation",
  "title": "logs/validation.json",
  "type": "object",
  "properties": {
    "checked_at": { "type": "string", "format": "date-time" },
    "trigger": { "enum": ["schedule", "manual", "after_sync", "cli"] },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ok": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "conflict_copy": { "type": "integer", "minimum": 0 }
      },
      "required": ["total", "ok", "error", "missing", "conflict_copy"]
    },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["sync", "ledger", "config", "view", "doc"] },
        "status": { "enum": ["ok", "error", "missing", "conflict_copy"] },
        "rule": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "records": { "type": ["integer", "null"] },
        "size": { "type": ["integer", "null"] },
        "modified_at": { "type": ["string", "null"], "format": "date-time" },
        "repair": { "type": ["string", "null"] }
      },
      "required": ["path", "kind", "status"]
    }
  },
  "required": ["checked_at", "trigger", "summary", "files"]
}
