{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/sku_stock",
  "title": "views/sku_stock.jsonl",
  "type": "object",
  "properties": {
    "sku": { "type": "string" },
    "title": { "type": "string" },
    "variant_title": { "type": ["string", "null"] },
    "category": { "type": "string" },
    "price": { "type": "number", "minimum": 0 },
    "stock_status": { "enum": ["in_stock", "out_of_stock", "preorder", "unknown"] },
    "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "days_in_status": { "type": "integer", "minimum": 0 },
    "online_rate_7d": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "online_rate_30d": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "history_30d": { "type": "string", "pattern": "^[iopu-]{30}$" },
    "changes_30d": { "type": "integer", "minimum": 0 },
    "last_change": { "type": ["string", "null"] },
    "last_change_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "parent_sku": { "type": ["string", "null"] },
    "price_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "price": { "type": "number", "minimum": 0 }
        },
        "required": ["date", "price"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sku", "title", "variant_title", "category", "price", "stock_status", "since", "days_in_status", "online_rate_7d", "online_rate_30d", "history_30d", "changes_30d", "last_change", "last_change_at"],
  "x-primary-key": ["sku"]
}
