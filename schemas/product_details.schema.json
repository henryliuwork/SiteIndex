{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteindex/product_details",
  "title": "catalog/product_details.jsonl",
  "type": "object",
  "properties": {
    "handle": { "type": "string" },
    "short_description": { "type": ["string", "null"] },
    "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
    "review_count": { "type": ["integer", "null"], "minimum": 0 },
    "breadcrumbs": { "type": "array", "items": { "type": "string" } },
    "gallery": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "related_handles": { "type": "array", "items": { "type": "string" } },
    "badges": { "type": "array", "items": { "type": "string" } },
    "shipping_note": { "type": ["string", "null"] },
    "last_crawled": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "required": ["handle", "short_description", "rating", "review_count", "breadcrumbs", "gallery", "related_handles", "badges", "shipping_note", "last_crawled"],
  "x-primary-key": ["handle"]
}
