{
  "schema_version": "1.0",
  "domain": "kingsyard.com",
  "base_url": "http://127.0.0.1:8765",
  "platform": "magento",
  "currency": "USD",
  "locale": "en-US",
  "timezone": "America/Los_Angeles",
  "markets": [
    "US"
  ],
  "brand": {
    "name": "Kingsyard",
    "tagline": "Wild bird feeding supplies for backyard birders.",
    "voice": "Warm, practical, nature-loving; short sentences",
    "audience": "Backyard bird lovers and gift buyers",
    "usp": [
      "Squirrel-resistant designs",
      "Easy to clean"
    ]
  },
  "sitemaps": [
    "http://127.0.0.1:8765/sitemap.xml"
  ],
  "crawl": {
    "adapter": "gmc_feed",
    "feed_url": "fixtures/feeds/day3.tsv",
    "sku_field": "id",
    "category_source": "product_type",
    "category_depth": 2,
    "category_map": {},
    "missing_as": "out_of_stock",
    "missing_removed_after_days": 30,
    "blog_url_patterns": [
      "/blog/",
      "/news/",
      "/\\d{4}/\\d{2}/"
    ],
    "max_pages": 2000,
    "rate_limit_ms": 200,
    "user_agent": "SiteOpsBot/1.0 (+https://{{DOMAIN}})",
    "exclude_url_patterns": [],
    "stock_rules": {
      "in_stock": [
        "add to cart",
        "in stock"
      ],
      "out_of_stock": [
        "sold out",
        "out of stock",
        "notify me"
      ],
      "preorder": [
        "pre-order",
        "preorder"
      ]
    },
    "overrides": {
      "KYBF012": {
        "title": "Kingsyard Feeder 12 (Override)"
      }
    }
  },
  "seo": {
    "core_keywords": [
      "bird feeders",
      "suet feeders",
      "bird houses",
      "bird baths"
    ],
    "competitors": []
  },
  "edm": {
    "platform": "mailchimp",
    "utm": {
      "source": "mailchimp",
      "medium": "email"
    },
    "max_products": 6,
    "cooldown_days": 21,
    "brand_color": "#1f3a2e",
    "font_stack": "Helvetica,Arial,sans-serif",
    "template_notes": "600px 单栏；按钮色使用品牌主色；所有图片带 alt；价格保留两位小数"
  },
  "integrations": {
    "linkflow": {
      "mcp_server": "linkflow",
      "create_tool": "create_prospect",
      "project": "Kingsyard"
    }
  }
}