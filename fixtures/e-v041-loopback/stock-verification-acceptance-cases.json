        "new_candidate_before_cursor": "SYN-CHURN-15",
        "removed_candidate_now_in_feed": "SYN-CHURN-20",
        "feedRows": [{ "sku": "SYN-CHURN-FEED" }, { "sku": "SYN-CHURN-20" }]
