    {
      "id": "restart-after-cursor-before-result-commit",
      "purpose": "A pending SKU is retried after the worker process stops after cursor persistence but before its inventory result is committed.",
      "classification": "required_regression_gate",
      "old_head": {
        "expected": "fail",
        "observed_head": "9ccb1a9b5f2e39d18956e466e804462eb767bda5",
        "reason": "daily.ts persists last_sku in beforeCandidate before the HTTP request and before verifyMissingStock returns results. After an interruption at the first request, a restart begins after that SKU and can spend the capped run on the next candidate, leaving the interrupted candidate pending until wraparound.",
        "expected_first_candidate_after_restart": "SYN-RST-02"
      },
      "project": {
        "max_per_run": 1,
        "initial_cursor": null,
        "active_missing_skus": [
          { "sku": "SYN-RST-01", "stock_status": "out_of_stock", "since": "2026-10-20", "checked_at": "2026-10-20T12:00:00Z" },
          { "sku": "SYN-RST-02", "stock_status": "out_of_stock", "since": "2026-10-20", "checked_at": "2026-10-20T12:00:00Z" }
        ],
        "feedRows": [{ "sku": "SYN-RST-FEED" }]
      },
      "site_service": {
        "productResponsesBySku": {
          "SYN-RST-01": { "status": 200, "delayMs": 5000, "body": "<main>Synthetic: available</main>" },
          "SYN-RST-02": { "status": 200, "body": "<main>Synthetic: available</main>" }
        }
      },
      "graphql_service": {
        "responsesBySku": {
          "SYN-RST-01": { "httpStatus": 200, "body": { "data": { "product": { "sku": "SYN-RST-01", "stock_status": "IN_STOCK" } } } },
          "SYN-RST-02": { "httpStatus": 200, "body": { "data": { "product": { "sku": "SYN-RST-02", "stock_status": "IN_STOCK" } } } }
        }
      },
      "steps": [
        "Create a temporary synthetic project and start its daily job in a child process.",
        "Keep the loopback product response delayed; poll only the fixture route count until the first product GET is observed, then terminate the child before the delayed response completes.",
        "Verify the interrupted run did not commit a stock result for SYN-RST-01 and retain the project plus cursor file.",
        "Restart daily against the same synthetic project and loopback services; inspect resulting inventory rows and events."
      ],
      "expected_after_recovery": {
        "first_resumed_candidate": "SYN-RST-01",
        "sku_status": "active",
        "stock_status": "in_stock",
        "event_for_interrupted_sku": "feed_anomaly",
        "no_duplicate_removed_event": true
      }
    },
    {
