{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/sku_tags",
  "title": "enrich/sku_tags.csv",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "exclude_edm": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "sku",
    "updated_at"
  ],
  "x-primary-key": [
    "sku"
  ]
}