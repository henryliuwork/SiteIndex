{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/site",
  "title": "site.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "pattern": "^(?!https?://)[a-z0-9.-]+$"
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "platform": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "voice",
        "audience"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "usp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sitemaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crawl": {
      "type": "object",
      "required": [
        "adapter",
        "rate_limit_ms",
        "stock_rules"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "rate_limit_ms": {
          "type": "integer",
          "minimum": 200
        },
        "user_agent": {
          "type": "string"
        },
        "exclude_url_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stock_rules": {
          "type": "object"
        },
        "overrides": {
          "type": "object"
        }
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "core_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edm": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "utm": {
          "type": "object"
        },
        "max_products": {
          "type": "integer"
        },
        "cooldown_days": {
          "type": "integer"
        },
        "template_notes": {
          "type": "string"
        }
      }
    },
    "integrations": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "base_url",
    "platform",
    "currency",
    "locale",
    "timezone",
    "brand",
    "sitemaps",
    "crawl",
    "seo",
    "edm"
  ],
  "x-primary-key": []
}