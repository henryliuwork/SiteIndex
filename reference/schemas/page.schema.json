{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/page",
  "title": "catalog/pages.jsonl",
  "type": "object",
  "properties": {
    "url": {
      "type": "string"
    },
    "type": {
      "enum": [
        "home",
        "collection",
        "page",
        "other"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "h1": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_code": {
      "type": "integer"
    },
    "indexable": {
      "type": "boolean"
    },
    "word_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_crawled": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "url",
    "type",
    "status_code",
    "indexable",
    "last_crawled"
  ],
  "x-primary-key": [
    "url"
  ]
}