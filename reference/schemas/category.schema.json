{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/category",
  "title": "catalog/categories.json[]",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "slug",
    "name",
    "url",
    "last_seen"
  ],
  "x-primary-key": [
    "slug"
  ]
}