{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/outreach_contact",
  "title": "outreach/contacted.jsonl",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^(?!www\\.)[a-z0-9.-]+\\.[a-z]{2,}$"
    },
    "added_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "pushed",
        "contacted",
        "replied",
        "partnered",
        "rejected",
        "invalid"
      ]
    },
    "linkflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "domain",
    "added_at",
    "status"
  ],
  "x-primary-key": [
    "domain"
  ]
}