{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siteops/edm_campaign",
  "title": "edm/index.jsonl",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "theme": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ]
    },
    "handles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mailchimp_campaign_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "send_date": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "campaign_id",
    "date",
    "theme",
    "status",
    "handles"
  ],
  "x-primary-key": [
    "campaign_id"
  ]
}